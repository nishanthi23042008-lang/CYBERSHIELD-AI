# GEMINI_API_KEY: Required for server-side OCR and structured invoice extraction via @google/genai.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Supabase Configuration (connects Frontend + PostgreSQL + Auth + Storage)
# Leave blank to run with the built-in local Express + persistent file vault backend.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Server-only secret for session signing (auto-generated in memory if omitted)
SESSION_SECRET=""
